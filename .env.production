# 🌐 分销系统前端生产环境配置
# Vue 应用生产环境变量配置文件

# API 基础地址 - Docker 容器内部通过 nginx 代理
VITE_API_BASE_URL=/api

# 应用标题
VITE_APP_TITLE=分销系统管理后台

# 应用版本
VITE_APP_VERSION=1.0.0

# 构建时间戳
VITE_BUILD_TIMESTAMP=__BUILD_TIME__

# 生产环境标识
NODE_ENV=production

# 禁用开发工具
VITE_APP_DEV_TOOLS=false

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=10000

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 是否启用调试模式
VITE_DEBUG=false

# 应用主题配色
VITE_THEME_COLOR=#1890ff

# JWT Token 过期时间（小时）
VITE_TOKEN_EXPIRE_HOURS=24

# 文件上传大小限制（MB）
VITE_UPLOAD_MAX_SIZE=10

# 是否启用多语言
VITE_I18N_ENABLED=false

# 默认语言
VITE_DEFAULT_LOCALE=zh-CN